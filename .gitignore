# ---------------------------------------------------------------------------
# External data — not version controlled
# These are large inputs downloaded/generated from upstream sources.
# Document provenance and download commands in scripts/, not git history.
# ---------------------------------------------------------------------------
data/
CATS2008/
CATS2008.zip

# ---------------------------------------------------------------------------
# Pipeline outputs
#
# strips/*_strips.csv, tests/figures/ and tests/*.png below carried trailing
# `# ...` comments, which git treats as part of the pattern rather than as a
# comment — all three matched nothing. The comments now sit on their own lines,
# deliberately activating the rules.
# ---------------------------------------------------------------------------
results/
processed/
# regenerable from pdt.search
strips/*_strips.csv
plots/
correction_plots/
velocity_plots/
*_aligned/
ASP_aligned/
# demo / sanity-check outputs; regenerable
tests/figures/
# gate/sanity plots written next to the scripts
tests/*.png

# ---------------------------------------------------------------------------
# Per-basin local decision records, stamped by scripts/new_basin.py.
# Unanchored so it covers examples/<basin>/NOTES.md and any future location.
# ---------------------------------------------------------------------------
NOTES.md

# ---------------------------------------------------------------------------
# Literature / papers / proposals — local-only reference material
# ---------------------------------------------------------------------------
literature/

# Stray reference material / bulk downloads dropped at the workspace root.
# Root-anchored so nothing inside the package is caught.
/*.pdf
/*.zip
/._*

# ---------------------------------------------------------------------------
# Figures — regenerable pipeline output (matches the plots/ rule above)
# ---------------------------------------------------------------------------
figures/
*/figures/
# bundled figure exports: regenerable, and the PIG one is over GitHub's limit
**/figures.zip
scripts/deletable_strips.txt
scripts.tar.gz

# Intermediate shapefiles written by the pipeline (not inputs)
low_velocity_strip.*
low_velocity_polygons.*
rock_polygons.*

# ---------------------------------------------------------------------------
# Logs / misc runtime artifacts
# ---------------------------------------------------------------------------
nohup.out
*.log
*.out
!requirements*.txt

# ---------------------------------------------------------------------------
# Data files — type-level backstop.
# The data/ , processed/ , results/ , strips/ rules above already cover the
# bulk caches by location; these catch a stray granule or raster that lands
# anywhere else. Input geometry (AOI shapefiles) is deliberately NOT listed
# here — see the shapefile rules above, which name the pipeline-written ones.
# ---------------------------------------------------------------------------
# Rasters / DEMs
*.tif
*.tiff
*.vrt
*.img
*.jp2
*.jpx

# Granules / gridded cubes
*.h5
*.hdf5
*.he5
*.hdf
*.nc
*.nc4
*.zarr/
*.grib
*.grib2

# Serialized arrays / tables
*.npy
*.npz
*.pkl
*.pickle
*.feather
*.parquet

# Point clouds / geodesy grids
*.las
*.laz
*.xyz
*.grd
*.gmt

# Archives
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.xz
*.7z
*.rar

# Run logs (the *.log rule above misses sidecar CSVs written next to them)
logs/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Editable installs
pip-log.txt
pip-delete-this-directory.txt

# ---------------------------------------------------------------------------
# Virtual envs (conda env lives outside repo; these are just in case)
# ---------------------------------------------------------------------------
.venv/
venv/
env/

# ---------------------------------------------------------------------------
# Jupyter
# ---------------------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---------------------------------------------------------------------------
# IDE / editor
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ---------------------------------------------------------------------------
# Secrets — never commit
# ---------------------------------------------------------------------------
.env
.cdsapirc
*.pem
*.key
credentials.json

# ---------------------------------------------------------------------------
# Vendored reference repos (clones for reading only, not part of this package)
# ---------------------------------------------------------------------------
vendor/

# ---------------------------------------------------------------------------
# elmer_synth synthetic-experiment run outputs (large; regenerable)
# ---------------------------------------------------------------------------
examples/elmer_synth/runs/
